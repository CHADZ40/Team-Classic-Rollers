NODE_ENV=production
HOST=127.0.0.1
PORT=3100
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_SITE_ORIGIN=https://teamclassicrollers.club,https://www.teamclassicrollers.club,https://games.teamclassicrollers.club
DATA_FILE=/var/lib/tcr/site-data.json
UPLOAD_DIR=/var/lib/tcr/uploads
LOG_FILE=/var/lib/tcr/logs.json

REQUESTS_FILE=/var/lib/tcr/game-requests.json

# TCR v0.1.4 member portal integration
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_BOT_TOKEN=token_from_botfather
# Chats that get score request alerts and can approve them. Send /chatid to the bot to find an ID.
# Separate several with commas. Group IDs start with a minus sign. Anyone in a listed group can approve.
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_INTERNAL_SECRET=generate_with_openssl_rand_hex_32
MEMBER_PORTAL_ORIGIN=https://admin.teamclassicrollers.club
# Where members sign in and see their portal. Telegram sign-in links open here.
MEMBER_SITE_ORIGIN=https://teamclassicrollers.club
TCR_INTERNAL_API=http://127.0.0.1:3100

# Face check-in for attendance. See face-service/README.md.
FACE_SERVICE_URL=http://127.0.0.1:3200
# Optional. Leave empty to use the limits tuned for the model.
FACE_STRONG_MATCH=
FACE_UNSURE_MATCH=
FACE_SAME_PERSON=
# Days to keep the photo saved with each face check-in. 0 stops saving them.
CHECKIN_PHOTO_DAYS=90
